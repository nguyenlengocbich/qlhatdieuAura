generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model SiteSection {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  name        String
  title       String?
  subtitle    String?
  description String?
  content     String?
  image       String?
  sortOrder   Int      @default(0)
  status      String   @default("published")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SiteItem {
  id          Int      @id @default(autoincrement())
  sectionKey  String
  title       String
  description String?
  icon        String?
  image       String?
  sortOrder   Int      @default(0)
  status      String   @default("published")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
model AdminUser {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  name         String
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}